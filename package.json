{
  "name": "qc-productivity-tracker",
  "version": "2.0.5",
  "description": "Tampermonkey tracker for QC productivity on WMS return inbound flows",
  "type": "module",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:css && node build/build.js",
    "dev": "nodemon --watch src --watch scripts scripts/build-userscript.js"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "esbuild": "^0.19.0"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "@supabase/supabase-js": "^2.39.0",
    "@vercel/og": "^0.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@sparticuz/chromium": "^149.0.0",
    "puppeteer-core": "^25.3.0",
    "xlsx": "^0.18.5",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.25",
    "autoprefixer": "^10.5.4"
  }
}
