{
  "manifest_version": 3,
  "name": "Arrival Sort Pro",
  "version": "2.2.2",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://wms.ssc.shopee.vn/*",
    "https://script.google.com/*",
    "https://return-sort-arrived.vercel.app/*",
    "https://printproxy.wms.shopeemobile.com:21317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://wms.ssc.shopee.vn/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
