{
  "manifest_version": 3,
  "name": "Arrival Sort",
  "version": "2.2.3",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://wms.ssc.shopee.vn/*",
    "https://script.google.com/*",
    "https://return-sort-arrived.vercel.app/*",
    "https://printproxy.wms.shopeemobile.com:21317/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Arrival Sort"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://wms.ssc.shopee.vn/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
